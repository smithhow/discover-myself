    { "id": "p18", "type": "personality", "dimension": "extraversion", "kind": "likert", "reverse": false, "text": "我常常是话题的发起者。", "options": ["非常不同意", "不同意", "一般", "同意", "非常同意"] },

    { "id": "p19", "type": "personality", "dimension": "agreeableness", "kind": "likert", "reverse": false, "text": "我愿意花时间帮助别人。", "options": ["非常不同意", "不同意", "一般", "同意", "非常同意"] },
    { "id": "p20", "type": "personality", "dimension": "agreeableness", "kind": "likert", "reverse": false, "text": "我倾向于相信他人的善意。", "options": ["非常不同意", "不同意", "一般", "同意", "非常同意"] },
    { "id": "p21", "type": "personality", "dimension": "agreeableness", "kind": "likert", "reverse": true, "text": "我很容易与人发生争执。", "options": ["非常不同意", "不同意", "一般", "同意", "非常同意"] },
