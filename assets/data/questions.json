    { "id": "p23", "type": "personality", "dimension": "agreeableness", "kind": "likert", "reverse": true, "text": "我常常对他人感到不耐烦。", "options": ["非常不同意", "不同意", "一般", "同意", "非常同意"] },
    { "id": "p24", "type": "personality", "dimension": "agreeableness", "kind": "likert", "reverse": false, "text": "我乐于与人合作而不是竞争。", "options": ["非常不同意", "不同意", "一般", "同意", "非常同意"] },

    { "id": "p25", "type": "personality", "dimension": "emotional_stability", "kind": "likert", "reverse": false, "text": "即使在压力下，我也能保持冷静。", "options": ["非常不同意", "不同意", "一般", "同意", "非常同意"] },
