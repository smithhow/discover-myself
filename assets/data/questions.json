    { "id": "p27", "type": "personality", "dimension": "emotional_stability", "kind": "likert", "reverse": false, "text": "我很少因为小事而烦恼很久。", "options": ["非常不同意", "不同意", "一般", "同意", "非常同意"] },
    { "id": "p28", "type": "personality", "dimension": "emotional_stability", "kind": "likert", "reverse": false, "text": "遇到挫折时我能较快调整心态。", "options": ["非常不同意", "不同意", "一般", "同意", "非常同意"] },
    { "id": "p29", "type": "personality", "dimension": "emotional_stability", "kind": "likert", "reverse": false, "text": "我很少感到莫名的紧张。", "options": ["非常不同意", "不同意", "一般", "同意", "非常同意"] },
